diff --git a/core/libs/Audio/effect_sampleRateReduction.cpp b/core/libs/Audio/effect_sampleRateReduction.cpp
new file mode 100644
index 0000000..65f57b9
--- /dev/null
+++ b/core/libs/Audio/effect_sampleRateReduction.cpp
@@ -0,0 +1,95 @@
+#ifdef MOD_SAMPLE_INSTRUMENT_FX
+#include "effect_sampleRateReduction.h"
+#include <math.h>
+
+float AudioSampleRateReduction::effectiveRateHz(uint8_t value)
+{
+    const float x = (float)value / 255.0f;
+    return kMaxRateHz * expf(x * x * logf(kMinRateHz / kMaxRateHz));
+}
+
+AUDIO_CORE_FLASH void AudioSampleRateReduction::setReduction(uint8_t value)
+{
+    uint32_t inc = 0;
+    if (value != 0)
+    {
+        // ratio = effective rate / output rate, strictly < 1 for value > 0.
+        const float ratio = effectiveRateHz(value) / kMaxRateHz;
+        const float scaled = ratio * 4294967296.0f;
+        inc = scaled >= 4294967040.0f ? 0xFFFFFF00u : (uint32_t)scaled;
+        if (inc == 0)
+            inc = 1;
+    }
+    if (phaseIncrement == 0 && inc != 0)
+        captureNext = true; // leaving bypass: never output stale held data
+    phaseIncrement = inc;   // phase is deliberately preserved
+}
+
+AUDIO_CORE_FLASH void AudioSampleRateReduction::reset()
+{
+    phase = 0;
+    captureNext = true;
+    held[0] = 0;
+    held[1] = 0;
+}
+
+AUDIO_CORE_RAM void AudioSampleRateReduction::update(void)
+{
+    audio_block_t* in[kMaxChannels] = { nullptr, nullptr };
+    bool complete = true;
+
+    for (uint8_t ch = 0; ch < channels; ch++)
+    {
+        in[ch] = (phaseIncrement == 0) ? receiveReadOnly(ch) : receiveWritable(ch);
+        if (!in[ch])
+            complete = false;
+    }
+
+    if (!complete)
+    {
+        // Paired processing needs both blocks: drop the partner, advance no state.
+        for (uint8_t ch = 0; ch < channels; ch++)
+        {
+            if (in[ch])
+                release(in[ch]);
+        }
+        return;
+    }
+
+    if (phaseIncrement != 0)
+    {
+        uint32_t ph = phase;
+        const uint32_t inc = phaseIncrement;
+        bool first = captureNext;
+        int16_t h0 = held[0];
+        int16_t h1 = held[1];
+
+        for (int i = 0; i < AUDIO_BLOCK_SAMPLES; i++)
+        {
+            const uint32_t prev = ph;
+            ph += inc;
+            if (first || ph < prev) // wrap = capture event, shared by both channels
+            {
+                h0 = in[0]->data[i];
+                if (channels == 2)
+                    h1 = in[1]->data[i];
+                first = false;
+            }
+            in[0]->data[i] = h0;
+            if (channels == 2)
+                in[1]->data[i] = h1;
+        }
+
+        phase = ph;
+        captureNext = first;
+        held[0] = h0;
+        held[1] = h1;
+    }
+
+    for (uint8_t ch = 0; ch < channels; ch++)
+    {
+        transmit(in[ch], ch);
+        release(in[ch]);
+    }
+}
+#endif /* MOD_SAMPLE_INSTRUMENT_FX */
diff --git a/core/libs/Audio/effect_sampleRateReduction.h b/core/libs/Audio/effect_sampleRateReduction.h
new file mode 100644
index 0000000..173557d
--- /dev/null
+++ b/core/libs/Audio/effect_sampleRateReduction.h
@@ -0,0 +1,47 @@
+// MOD_SAMPLE_INSTRUMENT_FX - Sample-Rate Reduction (see features/sample-instrument-fx)
+//
+// Sample-and-hold decimator. Captures the input at a reduced effective rate and holds each captured
+// value until the next capture event. No interpolation and no anti-alias filter (aliasing is the
+// intended sound). The engine's real output rate, pitch, speed and duration are untouched.
+//
+// One instance serves a whole voice: 1 channel on the original Tracker, 2 channels (L/R) on i.MX.
+// Both channels share ONE phase accumulator (capture events are simultaneous); only the held values
+// are per channel.
+#ifndef LIBS_AUDIO_EFFECT_SAMPLERATEREDUCTION_H_
+#define LIBS_AUDIO_EFFECT_SAMPLERATEREDUCTION_H_
+#ifdef MOD_SAMPLE_INSTRUMENT_FX
+#include "AudioStream.h"
+
+class AudioSampleRateReduction : public AudioStream
+{
+  public:
+    static constexpr uint8_t kMaxChannels = 2;
+    static constexpr float kMaxRateHz = AUDIO_SAMPLE_RATE_EXACT; // parameter 0 (bypass)
+    static constexpr float kMinRateHz = 100.0f;                  // parameter 255
+
+    explicit AudioSampleRateReduction(uint8_t channelCount)
+      : AudioStream(channelCount, inputQueueArray)
+      , channels(channelCount)
+    {
+    }
+    virtual void update(void);
+
+    // 0 = exact bypass, 255 = 100 Hz. Does not reset the sampling phase.
+    void setReduction(uint8_t value);
+    // Deterministic voice-start state: first sample is captured, no stale held data.
+    void reset();
+
+    // Effective sampling frequency for a parameter value: fmax * (fmin/fmax)^(x^2), x = value/255.
+    static float effectiveRateHz(uint8_t value);
+
+  private:
+    audio_block_t* inputQueueArray[kMaxChannels];
+    const uint8_t channels;
+    uint32_t phaseIncrement = 0; // Q0.32 fraction of an output sample per capture; 0 = bypass
+    uint32_t phase = 0;
+    bool captureNext = true;
+    int16_t held[kMaxChannels] = { 0, 0 };
+};
+
+#endif /* MOD_SAMPLE_INSTRUMENT_FX */
+#endif /* LIBS_AUDIO_EFFECT_SAMPLERATEREDUCTION_H_ */
diff --git a/core/libs/Audio/filter_dj.cpp b/core/libs/Audio/filter_dj.cpp
new file mode 100644
index 0000000..f47f71b
--- /dev/null
+++ b/core/libs/Audio/filter_dj.cpp
@@ -0,0 +1,136 @@
+#ifdef MOD_SAMPLE_INSTRUMENT_FX
+#include "filter_dj.h"
+#include <math.h>
+
+float AudioFilterDJ::cutoffHz(int8_t value)
+{
+    const float t = (float)(value < 0 ? -(int)value : (int)value) / 100.0f; // 0..1
+    const float ratio = kMaxCutoffHz / kMinCutoffHz;                        // 1000
+    if (value < 0)
+        return kMaxCutoffHz * powf(1.0f / ratio, t); // 20 kHz -> 20 Hz
+    return kMinCutoffHz * powf(ratio, t);            // 20 Hz  -> 20 kHz
+}
+
+AUDIO_CORE_FLASH void AudioFilterDJ::reset()
+{
+    for (uint8_t ch = 0; ch < kMaxChannels; ch++)
+    {
+        z1[ch] = 0.0f;
+        z2[ch] = 0.0f;
+    }
+}
+
+AUDIO_CORE_FLASH void AudioFilterDJ::setValue(int8_t value)
+{
+    if (value > 100)
+        value = 100;
+    if (value < -100)
+        value = -100;
+
+    if (value == 0)
+    {
+        active = false;
+        return;
+    }
+
+    // Keep the cutoff safely below Nyquist so the bilinear prewarp stays well conditioned.
+    float fc = cutoffHz(value);
+    const float fcLimit = 0.49f * AUDIO_SAMPLE_RATE_EXACT;
+    if (fc > fcLimit)
+        fc = fcLimit;
+
+    const float w0 = 2.0f * (float)M_PI * fc / AUDIO_SAMPLE_RATE_EXACT;
+    const float cosw = cosf(w0);
+    const float alpha = sinf(w0) * 0.70710678f; // sin(w0) / (2Q), Q = 1/sqrt(2): Butterworth
+
+    float nb0, nb1, nb2;
+    if (value < 0) // low-pass
+    {
+        nb0 = (1.0f - cosw) * 0.5f;
+        nb1 = 1.0f - cosw;
+        nb2 = nb0;
+    }
+    else // high-pass
+    {
+        nb0 = (1.0f + cosw) * 0.5f;
+        nb1 = -(1.0f + cosw);
+        nb2 = nb0;
+    }
+    const float a0 = 1.0f + alpha;
+    const float na1 = -2.0f * cosw;
+    const float na2 = 1.0f - alpha;
+
+    if (!(a0 > 0.0f) || !isfinite(nb0) || !isfinite(na1) || !isfinite(na2)) // invalid -> bypass
+    {
+        active = false;
+        return;
+    }
+
+    const bool wasActive = active;
+    const float inv = 1.0f / a0;
+    b0 = nb0 * inv;
+    b1 = nb1 * inv;
+    b2 = nb2 * inv;
+    a1 = na1 * inv;
+    a2 = na2 * inv;
+    if (!wasActive)
+        reset(); // leaving bypass: start from silence, no stale state
+    active = true;
+}
+
+AUDIO_CORE_RAM void AudioFilterDJ::update(void)
+{
+    audio_block_t* in[kMaxChannels] = { nullptr, nullptr };
+    bool complete = true;
+    const bool process = active;
+
+    for (uint8_t ch = 0; ch < channels; ch++)
+    {
+        in[ch] = process ? receiveWritable(ch) : receiveReadOnly(ch);
+        if (!in[ch])
+            complete = false;
+    }
+
+    if (!complete)
+    {
+        for (uint8_t ch = 0; ch < channels; ch++)
+        {
+            if (in[ch])
+                release(in[ch]);
+        }
+        return;
+    }
+
+    if (process)
+    {
+        const float cb0 = b0, cb1 = b1, cb2 = b2, ca1 = a1, ca2 = a2;
+        for (uint8_t ch = 0; ch < channels; ch++)
+        {
+            float s1 = z1[ch];
+            float s2 = z2[ch];
+            int16_t* d = in[ch]->data;
+            for (int i = 0; i < AUDIO_BLOCK_SAMPLES; i++)
+            {
+                const float x = (float)d[i];
+                const float y = cb0 * x + s1;
+                s1 = cb1 * x - ca1 * y + s2;
+                s2 = cb2 * x - ca2 * y;
+                float o = y;
+                if (o > 32767.0f)
+                    o = 32767.0f;
+                else if (o < -32768.0f)
+                    o = -32768.0f;
+                d[i] = (int16_t)o;
+            }
+            z1[ch] = s1;
+            z2[ch] = s2;
+        }
+    }
+
+    for (uint8_t ch = 0; ch < channels; ch++)
+    {
+        transmit(in[ch], ch);
+        release(in[ch]);
+    }
+}
+#endif /* MOD_SAMPLE_INSTRUMENT_FX */
diff --git a/core/libs/Audio/filter_dj.h b/core/libs/Audio/filter_dj.h
new file mode 100644
index 0000000..1c1b67f
--- /dev/null
+++ b/core/libs/Audio/filter_dj.h
@@ -0,0 +1,44 @@
+// MOD_SAMPLE_INSTRUMENT_FX - DJ Filter (see features/sample-instrument-fx)
+//
+// Bipolar, non-resonant 2-pole (12 dB/oct) Butterworth biquad.
+//   value  -100 .. -1 : low-pass,  cutoff 20 kHz (at -1) .. 20 Hz (at -100), logarithmic
+//   value  0          : exact bypass (block passed through untouched, no filter state touched)
+//   value  +1 .. +100 : high-pass, cutoff 20 Hz (at +1) .. 20 kHz (at +100), logarithmic
+// One instance serves a whole voice: 1 channel (original Tracker) or 2 (i.MX L/R). Coefficients are
+// shared, state is per channel.
+#ifndef LIBS_AUDIO_FILTER_DJ_H_
+#define LIBS_AUDIO_FILTER_DJ_H_
+#ifdef MOD_SAMPLE_INSTRUMENT_FX
+#include "AudioStream.h"
+
+class AudioFilterDJ : public AudioStream
+{
+  public:
+    static constexpr uint8_t kMaxChannels = 2;
+    static constexpr float kMinCutoffHz = 20.0f;
+    static constexpr float kMaxCutoffHz = 20000.0f;
+
+    explicit AudioFilterDJ(uint8_t channelCount)
+      : AudioStream(channelCount, inputQueueArray)
+      , channels(channelCount)
+    {
+    }
+    virtual void update(void);
+
+    void setValue(int8_t value); // clamps to -100..100; recalculates coefficients here, not per sample
+    void reset();                // clears filter state
+
+    // Cutoff in Hz for a non-zero value (LP for <0, HP for >0).
+    static float cutoffHz(int8_t value);
+
+  private:
+    audio_block_t* inputQueueArray[kMaxChannels];
+    const uint8_t channels;
+    bool active = false;
+    float b0 = 1.0f, b1 = 0.0f, b2 = 0.0f, a1 = 0.0f, a2 = 0.0f; // normalised (a0 = 1)
+    float z1[kMaxChannels] = { 0.0f, 0.0f };                       // transposed direct form II
+    float z2[kMaxChannels] = { 0.0f, 0.0f };
+};
+
+#endif /* MOD_SAMPLE_INSTRUMENT_FX */
+#endif /* LIBS_AUDIO_FILTER_DJ_H_ */
